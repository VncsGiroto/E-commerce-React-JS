# MongoDB
MONGODB_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/ecommerce

# JWT Secrets (troque por valores longos e aleatórios)
JWT_ADMIN_SECRET=sua_chave_secreta_admin_super_segura
JWT_USER_SECRET=sua_chave_secreta_user_super_segura

# Porta (app usa 4000 se ausente)
PORT=5000

# Origem permitida no CORS (front-end)
CORS_ORIGIN=http://localhost:5173

# Ambiente: development | production (secure nos cookies só ativa em production)
NODE_ENV=development
